# Copy to .env next to docker-compose.yml (chmod 600) and fill in. setup.sh reads it.

# Public IP address (or DNS name) of this box. Trainers, the validator and GitHub's login callback reach it here.
BUILD_BOX_HOST=203.0.113.10

# Bucket for the images (S3-compatible: Backblaze B2, R2, S3). The registry keeps everything under S3_PREFIX.
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=god-images
S3_PREFIX=/god-image-registry
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Images are deleted this long after they were pushed.
IMAGE_RETENTION_HOURS=120

# GitHub OAuth app for the Woodpecker login (callback https://<BUILD_BOX_HOST>/authorize) and its admin user(s).
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=
WOODPECKER_ADMIN=

# Builds run at once. Each needs ~2 CPU cores, ~2GB RAM and up to ~80GB disk while it runs.
IMAGE_BUILD_CONCURRENCY=3

# For `setup.sh configure-repo` only: a Woodpecker API token (Woodpecker > User settings > CLI & API) and a GitHub token
# with read and write on the snapshot repo.
WOODPECKER_TOKEN=
SNAPSHOT_REPO=https://github.com/<owner>/god-image-builds.git
SNAPSHOT_TOKEN=
