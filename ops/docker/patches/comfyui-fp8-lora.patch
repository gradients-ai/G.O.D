+def _requantize_patched_weight(original, patched, seed, inplace_ops=False):
+    """Keep checkpoint FP8 scales stable when materializing a model patch."""
+    scale = "recalculate"
+    if original.storage_dtype in (torch.float8_e4m3fn, torch.float8_e5m2):
+        scale = original.params.scale.to(device=patched.device, dtype=torch.float32)
+        limit = scale * torch.finfo(original.storage_dtype).max
+        patched.clamp_(min=-limit, max=limit)
+    return original.requantize_from_float(
+        patched,
+        scale=scale,
+        stochastic_rounding=seed,
+        inplace_ops=inplace_ops,
+    )
+
